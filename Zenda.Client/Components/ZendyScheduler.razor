@using System.Globalization
@using Zenda.Core.DTOs

<div class="zendy-scheduler-container">
    <header class="scheduler-internal-header">
        <div class="view-toggle">
            <button class="@(VistaSemanal ? "" : "active")" @onclick="() => CambiarVista(false)">Diaria</button>
            <button class="@(VistaSemanal ? "active" : "")" @onclick="() => CambiarVista(true)">Semanal</button>
        </div>

        <div class="date-navigator">
            <button class="nav-btn" aria-label="Retroceder periodo" @onclick="Retroceder"><span aria-hidden="true">&lsaquo;</span></button>
            <span class="date-display" aria-live="polite">@ObtenerTextoFecha()</span>
            <button class="nav-btn" aria-label="Avanzar periodo" @onclick="Avanzar"><span aria-hidden="true">&rsaquo;</span></button>
        </div>
    </header>

    <div class="scheduler-scroll-area" id="calendar-scroll-container">
        <div class="scheduler-grid @(VistaSemanal ? "vista-semanal" : "vista-diaria")">

            @* Cabecera Dinámica de Zona Horaria *@
            @{
                var offset = ZonaHorariaLocal.GetUtcOffset(DateTime.UtcNow);
            }
            <div class="day-header" style="grid-column: 1;">GMT@(offset.Hours >= 0 ? "+" : "")@offset.Hours</div>

            @* Generación de Columnas y Slots de Fondo *@
            @{
                var inicioPeriodo = ObtenerInicioPeriodo();
            }
            @for (int i = 0; i < (VistaSemanal ? 7 : 1); i++)
            {
                var fechaColumna = inicioPeriodo.AddDays(i);
                bool esHoy = fechaColumna.Date == TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ZonaHorariaLocal).Date;
                int colIndex = VistaSemanal ? i + 2 : 2;

                <div id="@(esHoy ? "columna-hoy" : "")" class="day-header @(esHoy ? "today" : "")" style="grid-column: @colIndex;">
                    <span>@fechaColumna.ToString("ddd", new CultureInfo("es-AR")).ToUpper()</span>
                    <span class="date-num">@fechaColumna.Day</span>
                </div>

                <div class="day-column-separator @(esHoy ? "bg-today" : "")" style="grid-column: @colIndex; grid-row: 2;">
                    @* Renderizado de slots vacíos clickeables (cada 30 min) *@
                    @for (int h = 0; h < 24; h++)
                    {
                        int horaCierre = h;
                        <div class="slot-vacio" style="top: @(horaCierre * 60)px;" @onclick="() => IniciarNuevoTurno(fechaColumna, horaCierre, 0)"></div>
                        <div class="slot-vacio" style="top: @((horaCierre * 60) + 30)px;" @onclick="() => IniciarNuevoTurno(fechaColumna, horaCierre, 30)"></div>
                    }
                </div>
            }

            @* Eje Horario Horizontal *@
            @for (int i = 0; i < 24; i++)
            {
                <div class="time-label-row" style="top: @(i * 60)px;">
                    <span class="time-text">@i.ToString("00"):00</span>
                </div>
            }

            @* Línea Transversal de Hora Actual *@
            @if (MuestraElDiaDeHoy())
            {
                var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ZonaHorariaLocal);
                var topMinutos = (now.Hour * 60) + now.Minute;

                @* FIX: antes "grid-column: @CalcularColumna(now)" sin línea de cierre,
                   por lo que la línea roja se estiraba hasta el borde derecho de toda
                   la grilla en vez de quedar acotada al día de hoy. *@
                <div id="linea-hora-actual" class="linea-hora-actual" style="top: @(topMinutos)px; grid-column: @GridColumnaAcotada(CalcularColumna(now));">
                    <div class="circulo-hora"></div>
                </div>
            }

            @* Renderizado de Tarjetas de Turno (Posicionamiento Absoluto) *@
            @if (!TurnosVisibles.Any())
            {
                <div class="empty-state-msg">No se registran turnos en este período.</div>
            }
            else
            {
                @foreach (var uiTurno in ProcesarTurnosVisuales(TurnosVisibles))
                {
                    var horaInicioTurno = TimeZoneInfo.ConvertTimeFromUtc(uiTurno.Data.FechaHoraInicioUtc, ZonaHorariaLocal);
                    var horaFinTurno = TimeZoneInfo.ConvertTimeFromUtc(uiTurno.Data.FechaHoraFinUtc, ZonaHorariaLocal);
                    var tooltip = $"{uiTurno.Data.ClienteNombre} - {uiTurno.Data.ServicioNombre} ({horaInicioTurno:HH:mm}-{horaFinTurno:HH:mm})" +
                                  (!string.IsNullOrWhiteSpace(uiTurno.Data.PrestadorNombre) ? $" · {uiTurno.Data.PrestadorNombre}" : "");
                    @* FIX: turnos cortos (< 40 min) usan "turno-compacto": una sola línea
                       (hora + cliente) en vez de apilar 2-3 líneas que no entran en el alto
                       real del turno y terminaban recortadas/ilegibles. El profesional, en
                       ese caso, se mueve al tooltip (title) en vez de ocupar una línea propia. *@
                    <div class="turno-card estado-@uiTurno.Data.Estado.ToString().ToLower() @(uiTurno.EsCompacto ? "turno-compacto" : "")"
                         style="top: @(uiTurno.TopPx)px; height: @(uiTurno.HeightPx)px;
                                        left: @(uiTurno.LeftPorcentaje.ToString(CultureInfo.InvariantCulture))%;
                                        width: @(uiTurno.WidthPorcentaje.ToString(CultureInfo.InvariantCulture))%;
                                        grid-column: @GridColumnaAcotada(uiTurno.ColumnaGrid);"
                         title="@tooltip"
                         @onclick="() => OnTurnoSeleccionado.InvokeAsync(uiTurno.Data)">

                        <span class="turno-time">@horaInicioTurno.ToString("HH:mm")</span>
                        <strong class="turno-client">@uiTurno.Data.ClienteNombre</strong>
                        @if (!uiTurno.EsCompacto && !string.IsNullOrWhiteSpace(uiTurno.Data.PrestadorNombre))
                        {
                            <span class="turno-prof">(@uiTurno.Data.PrestadorNombre)</span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
