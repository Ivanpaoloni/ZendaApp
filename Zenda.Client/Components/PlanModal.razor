@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav

@if (Visible)
{
    <!-- Se añaden atributos ARIA para accesibilidad -->
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999;"
         class="flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm animate-in fade-in duration-200"
         @onclick="Cerrar" role="dialog" aria-modal="true">

        <div class="relative bg-white rounded-[2.5rem] p-6 md:p-8 w-full max-w-sm border border-surface-container-high shadow-2xl flex flex-col max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">

            <button @onclick="Cerrar" disabled="@IsLoading" aria-label="Cerrar modal" class="absolute top-4 right-4 md:top-6 md:right-6 w-8 h-8 flex items-center justify-center rounded-full bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors disabled:opacity-50">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">close</span>
            </button>

            <div class="w-16 h-16 md:w-20 md:h-20 bg-primary/10 text-primary rounded-full flex shrink-0 items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-3xl md:text-4xl font-bold" aria-hidden="true">@Icono</span>
            </div>

            <h3 class="font-headline font-bold text-xl md:text-2xl text-primary mb-2 text-center">@Titulo</h3>

            <div class="text-on-surface-variant text-sm mb-4 flex-grow text-center">
                @ChildContent
            </div>

            <!-- Contenedor de Botones de Acción -->
            <div class="flex flex-col gap-2 mt-4">
                @if (MostrarBotonPrincipal)
                {
                    <button @onclick="EjecutarAccion" disabled="@IsLoading" class="w-full py-3 rounded-xl bg-primary text-white font-bold hover:bg-primary/90 transition-colors flex justify-center items-center disabled:opacity-70">
                        @if (IsLoading)
                        {
                            <span class="material-symbols-outlined animate-spin text-[20px] mr-2">progress_activity</span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            @TextoAccionPrincipal
                        }
                    </button>
                }

                <button @onclick="Cerrar" disabled="@IsLoading" class="text-sm font-bold text-on-surface-variant hover:text-primary transition-colors w-full py-2 rounded-xl hover:bg-surface-container-low disabled:opacity-50">
                    @TextoCancelar
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    // Parámetros por defecto generalizados
    [Parameter] public string Titulo { get; set; } = "Gestionar Plan";
    [Parameter] public string Icono { get; set; } = "autorenew";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Nuevos parámetros para inyectar comportamiento
    [Parameter] public bool MostrarBotonPrincipal { get; set; } = true;
    [Parameter] public string TextoAccionPrincipal { get; set; } = "Confirmar";
    [Parameter] public string TextoCancelar { get; set; } = "Cancelar";
    [Parameter] public EventCallback OnAccionPrincipal { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private async Task Cerrar()
    {
        if (IsLoading) return; // Previene cerrar si hay una transacción en curso
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task EjecutarAccion()
    {
        if (OnAccionPrincipal.HasDelegate)
        {
            await OnAccionPrincipal.InvokeAsync();
        }
    }
}